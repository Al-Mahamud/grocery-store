# Settings for deploy/compose.yaml. Copy to deploy/.env, fill in, and keep it private:
# it holds passwords. docs/DEPLOY.md explains each one.

# The shop's address, without https:// (Caddy gets the certificate for it).
DOMAIN=haat.example

# A long random password for the database (e.g. `openssl rand -base64 30`).
POSTGRES_PASSWORD=

# Texts: sslwireless for real SMS. "log" only works with STAGING=true (a test server).
SMS_DRIVER=sslwireless
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=
# STAGING=true

# Online payment (bKash, Nagad, cards). Leave empty for cash on delivery only.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Sandbox until SSLCommerz approves the live store; then https://securepay.sslcommerz.com
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com

# The first staff account, made on the first start only. Remove these two lines afterwards.
ADMIN_NAME=Owner
ADMIN_PHONE=
ADMIN_PASSWORD=
